# Bench: synthetic audio fixtures (regenerated by make_fixtures.py), the
# benchmark's raw JSON output (regenerated by benchmark.py), and any large
# exported model artifact (sha256 recorded in worker/bench/README.md)
worker/bench/fixtures/*.wav
worker/bench/fixtures/*.flac
worker/bench/results_*.json
worker/models/*.onnx
!worker/models/.gitkeep

# agent dev rig: astro dev() + a hand-minted local JWT. Never shipped.
*.local.mjs
