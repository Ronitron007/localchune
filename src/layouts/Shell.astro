---
// src/layouts/Shell.astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
//
// The shell owns four things beyond the frame: the <ClientRouter />, the
// persisted player div, the persisted upload chip, and the one site script.
// The router swaps page bodies AROUND the transition:persist nodes, which is
// what lets playback survive filter submits, sort clicks, pagination and
// detail navigation — butternutcrack needed 345 lines and a store for the
// same property.
import { ClientRouter } from 'astro:transitions'
import AppNav from '../components/AppNav.astro'
import SourceLink from '../components/SourceLink.astro'
import StorageChip from '../components/StorageChip.astro'
import UploadChip from '../components/UploadChip'
import '../styles/global.css'

// Task 8: `center` is for the app's "single card" pages (currently just
// /welcome — /login has no Shell at all, see its own body.loginpage rule
// in global.css). It adds body.centerpage, which vertically AND
// horizontally centers <main>'s content between AppNav and the footer —
// see global.css's `body.centerpage main` rule for the mechanics.
interface Props { title: string; center?: boolean }
const { title, center = false } = Astro.props
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <ClientRouter />
</head>
<body class={center ? 'centerpage' : undefined}>
  <AppNav />
  <main><slot /></main>
  <footer class="appfoot">
    <StorageChip />
    <SourceLink />
  </footer>
  {/* Task 3: native `controls` renders inconsistently on mobile and hides
      the seek affordance entirely on some phones. The <audio> element
      stays as the playback engine (no `controls` attr, so it draws no
      box of its own) and this custom row — play/pause, a touch-friendly
      range seek, elapsed/total — replaces it. Everything here lives
      inside the SAME transition:persist="player" node as before, so it
      survives a ClientRouter navigation exactly like the old markup did;
      see src/scripts/site.ts for the wiring. */}
  <div class="playerbar" transition:persist="player">
    <span id="player-label" class="nowplaying" aria-live="polite"></span>
    <button id="player-toggle" type="button" class="playertoggle" aria-label="Play">▶</button>
    <input id="player-seek" type="range" class="playerseek" min="0" max="0" step="1" value="0" aria-label="Seek" />
    <span id="player-time" class="playertime num">0:00 / --:--</span>
    <audio id="player-audio" preload="none"></audio>
  </div>
  {/* UX.12: browse while uploading. The engine itself is a module singleton
      (src/lib/upload-engine.ts) and survives a soft navigation with or
      without this island — but the CHIP has to render on every page and must
      not remount on each one, so it persists exactly like the player above.
      Mounted AFTER .playerbar so that if the two ever overlap, the chip wins
      the paint order without needing a z-index. client:load rather than
      client:idle: a member returning to a tab mid-batch should see the chip
      immediately, not after the main thread goes quiet. */}
  <UploadChip client:load transition:persist="uploadchip" />
  <script src="../scripts/site.ts"></script>
</body>
</html>
