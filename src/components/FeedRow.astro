---
// src/components/FeedRow.astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
//
// M6c Task 2 — one compact card in the home feed's Fresh/Hot/Top sections.
// Takes the same PoolTrack shape TrackRow.astro renders (feed_tracks rows
// are adapted onto it by pool-api.ts's feedTrackToPoolTrack, the same
// has_preview/has_peaks/has_thumb-from-*_key convention crateItemToPoolTrack
// already established for crate_get() rows) — so a like count, a BPM, or a
// key chip never reads differently here than it does in the pool table.
//
// The play control reproduces TrackRow's exact M6b `a.play` contract —
// data-track-id/label plus the queue metadata attrs (artist, title,
// duration, bpm, key) site.ts scrapes when a play inside a
// [data-queue-list] container builds the queue from the rendered list.
// The hidden `+Q` companion follows TrackRow's rule verbatim: unhidden by
// site.ts, invisible without JS because the queue is client state with no
// server fallback, and — since perf task 2.2 — carrying `data-file-id`
// alone. No like toggle here on purpose — the feed is read-only; toggling
// lives on the track page and the pool table.
import Icon from './Icon.astro'
import KeyChip from './KeyChip.astro'
import { artThumb2xUrl, artThumbUrl, formatBpm, LIKE_ICON } from '../lib/track-format'
import type { PoolTrack } from '../lib/pool-api'

interface Props { track: PoolTrack }
const { track } = Astro.props
const artist = track.display_artist ?? 'Unknown artist'
const label = `${artist} — ${track.display_title}`
---
{/* data-play-row and the artwork-as-play-link: TrackRow.astro's exact
    rework, for the same owner directive and by the same mechanism. The
    two rows converge rather than diverge — that was the whole point of
    giving them one `a.play` contract in the first place. */}
<li class="feedrow" data-play-row>
  <a
    class="play"
    href={`/track/${track.file_id}`}
    data-track-id={track.file_id}
    data-artist={track.display_artist ?? undefined}
    data-title={track.display_title}
    data-duration={track.duration_ms ?? undefined}
    data-bpm={track.bpm ?? undefined}
    data-key={track.key_camelot ?? undefined}
    aria-label={`Play ${track.display_title}`}
  >{track.has_thumb
    ? <img class="thumb" src={artThumbUrl(import.meta.env.PUBLIC_ART_BASE_URL, track.file_id)} srcset={`${artThumb2xUrl(import.meta.env.PUBLIC_ART_BASE_URL, track.file_id)} 2x`} alt="" width="44" height="44" loading="lazy" />
    : <span class="thumb-empty" aria-hidden="true"></span>}</a>
  {/* PERF TASK 2.2 — `data-file-id` only, exactly as TrackRow.astro's
      companion: site.ts reads this row's own `a.play` for the queue
      metadata rather than a second copy of it on the button. */}
  <button
    type="button"
    class="queueadd btn-secondary btn-icon"
    hidden
    data-file-id={track.file_id}
    aria-label={`Add ${track.display_title} to the queue`}
  ><Icon name="queue-add" size={16} /></button>
  <span class="feedrow-body">
    <a class="feedrow-title" href={`/track/${track.file_id}`}>{label}</a>
    <span class="feedrow-meta">
      <KeyChip camelot={track.key_camelot} open={track.key_open} musical={track.key_musical} />
      <span class="num">{formatBpm(track.bpm, track.ibi_std_ms)}</span>
      {/* A DISPLAY count, not a control — and it was a ♥ character, which
          is the same U+2665 iOS emoji-renders in the row and the player
          bar. The scanner that catches those only reads <button>/<a>
          bodies, so this one sat outside it: a red emoji heart in a
          monochrome meta run that no test could see. Same icon as the
          real like control, one step smaller because a meta run is dense. */}
      <span class="feedrow-likes"><Icon name={LIKE_ICON.name} size={12} /> {track.like_count}</span>
    </span>
  </span>
  {/* The row menu, exactly as TrackRow.astro's — see the long note there.
      A feed row has no metadata cells to unpack, so its sheet is the
      action half only. Last in the DOM because it is last in the row. */}
  <button
    type="button"
    class="rowmenu"
    hidden
    aria-haspopup="dialog"
    aria-label={`More actions for ${track.display_title}`}
  ><Icon name="kebab" size={20} /></button>
</li>
