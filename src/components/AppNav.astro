---
// src/components/AppNav.astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
import Icon from './Icon.astro'
import { creditsRemaining } from '../lib/session'
import { chromeData } from '../lib/page-data'
const m = Astro.locals.member!
const here = Astro.url.pathname

// M4 Task 7 — the review badge. One count(*), owner only.
//
// review_pending_count() RETURNS 0 for a non-owner rather than raising,
// because AppNav renders on every page for everyone and a nav that throws
// takes the whole site with it. The owner test below is therefore about
// what to SHOW, not about authorization — the database already answered
// that.
//
// A failed RPC degrades to no badge. The nav is not the place to report a
// database outage; the page below it will.
//
// PERF TASK 2.1 — the call itself moved to the middleware, which starts it
// before the page runs so it overlaps the page's own data instead of
// following it (Astro renders components after frontmatter, so an await
// here was always last). What is left is the same read of the same result:
// the owner test is now inside startChromeData, which skips the request
// entirely for a member and hands back 0.
const { reviewPending } = await chromeData(Astro.locals)
if (reviewPending.error) console.error('review_pending_count failed:', reviewPending.error.message)
const pending = typeof reviewPending.data === 'number' ? reviewPending.data : 0
---
<nav class="appnav">
  {/* THE WORDMARK, and on a phone it is the only always-visible way home.
      The spec rejected a bottom tab bar partly on this: the bottom edge
      already carries the player, the drawer anchored to it and the upload
      chip, so the one-thumb destination has to come from the top. */}
  <a class="appnav-wordmark" href="/">localchune</a>

  {/* Every destination, written ONCE. Below 640px site.ts hides this list
      and unhides the ⋮ beside it, then builds the sheet by READING these
      links — so the owner-only omission below is respected automatically
      and no destination is ever listed twice. */}
  <div class="appnav-links">
  {/* M6c Task 2: "/" is now the home feed; the browse table moved to
      "/pool". */}
  <a href="/" aria-current={here === '/' ? 'page' : undefined}>Home</a>
  <a href="/pool" aria-current={here === '/pool' ? 'page' : undefined}>Pool</a>
  <a href="/upload" aria-current={here === '/upload' ? 'page' : undefined}>Upload</a>
  <a href="/uploads" aria-current={here === '/uploads' ? 'page' : undefined}>My uploads</a>
  {/* M6a Task 6. */}
  <a href="/crates" aria-current={here.startsWith('/crates') || here.startsWith('/crate/') ? 'page' : undefined}>Crates</a>
  {/* M4 Task 7 — every member may read the merges feed. PRD §6: "wrong
      merges are cheap to undo only if someone notices", and one pair of
      eyes is not a lot of noticing. The Undo control inside is owner-only. */}
  <a href="/merges" aria-current={here === '/merges' ? 'page' : undefined}>Merges</a>
  {/* Admin and Review are owner-only — OMITTED rather than shown disabled — a
      disabled link is a promise with no delivery date, and it tells a
      non-owner that an admin page exists. The ⋮ sheet inherits this for
      free by reading the rendered links instead of listing them again. */}
  {m.role === 'owner' && (
    <a href="/review" aria-current={here === '/review' ? 'page' : undefined}>
      Review{pending > 0 && <span class="navbadge num">{pending}</span>}
    </a>
  )}
  {m.role === 'owner' && (
    <a href="/admin" aria-current={here.startsWith('/admin') ? 'page' : undefined}>Admin</a>
  )}
  </div>

  {/* Search is a LINK to the pool, where the search field already lives,
      rather than a second search UI. One search box in the app, one tap
      from anywhere. */}
  <a class="appnav-search btn-ghost" href="/pool" aria-label="Search the pool">
    <Icon name="search" size={20} />
  </a>

  {/* The ⋮. Hidden in the markup and unhidden by site.ts, which adds
      `is-compact` to this nav in the same pass — the two must happen
      together. With no JS there is no sheet, so a visible ⋮ would be a
      control that does nothing (survive-list #10) AND the link list it
      replaces would already be hidden. Without JS the list simply stays
      visible and wraps, exactly as it does today. */}
  <button
    type="button"
    id="nav-menu"
    class="appnav-menu btn-ghost"
    hidden
    aria-label="Menu"
    aria-haspopup="dialog"
  ><Icon name="kebab" size={20} /></button>
  {/* Task 7: greets by username once claimed, falling back to email
      exactly as before for a member the middleware hasn't yet routed
      through /welcome. */}
  <span class="who">{m.username ?? m.email}</span>
  <span class="credits">{creditsRemaining(m.access_expires_at)} credits</span>
  {/* data-astro-reload: /auth/signout reads no body, so it survives
      ClientRouter's multipart re-send today. It is opted out anyway, because
      the rule this repo now holds is "every POST form submits natively" —
      an invariant with two exceptions is one nobody can check. A sign-out
      also has to be a real document load: the response clears the auth
      cookies, and a full navigation is the only way every persisted island
      is torn down with them.

      The id is what the ⋮ sheet's "Sign out" row calls requestSubmit() on.
      That is the SAME form and the same native POST — the sheet adds a
      third trigger, not a second sign-out path, so survive-list #11 holds
      wherever the control is rendered. */}
  <form id="signout-form" method="post" action="/auth/signout" data-astro-reload><button type="submit" class="btn-secondary">Sign out</button></form>
</nav>
