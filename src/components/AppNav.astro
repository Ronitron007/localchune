---
// src/components/AppNav.astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
import Icon from './Icon.astro'
import { creditsRemaining } from '../lib/session'
import { chromeData } from '../lib/page-data'
const m = Astro.locals.member!
const here = Astro.url.pathname

// M4 Task 7 — the review badge. One count(*), owner only.
//
// review_pending_count() RETURNS 0 for a non-owner rather than raising,
// because AppNav renders on every page for everyone and a nav that throws
// takes the whole site with it. The owner test below is therefore about
// what to SHOW, not about authorization — the database already answered
// that.
//
// A failed RPC degrades to no badge. The nav is not the place to report a
// database outage; the page below it will.
//
// PERF TASK 2.1 — the call itself moved to the middleware, which starts it
// before the page runs so it overlaps the page's own data instead of
// following it (Astro renders components after frontmatter, so an await
// here was always last). What is left is the same read of the same result:
// the owner test is now inside startChromeData, which skips the request
// entirely for a member and hands back 0.
const { reviewPending } = await chromeData(Astro.locals)
if (reviewPending.error) console.error('review_pending_count failed:', reviewPending.error.message)
const pending = typeof reviewPending.data === 'number' ? reviewPending.data : 0
const credits = `${creditsRemaining(m.access_expires_at)} credits`
---
{/* UI TASK 3.2 — a 44px sticky bar, and below 640px a ⋮ instead of eight
    wrapped links.

    What it replaces: six to eight inline links plus who, credits and a
    sign-out form, all flex-wrap, collapsing to three or four rows of
    ~17px text on a phone — about 120px of chrome before any content, and
    a `margin-left: auto` alignment that breaks the moment it wraps. That
    was the audit's offender #4 and the single largest vertical win
    available on a 667px screen.

    ONE SET OF LINKS, TWO PRESENTATIONS. The destinations are rendered
    once, here. Above 640px they are the inline row they always were,
    restyled. Below it they are hidden and site.ts builds the ⋮ sheet BY
    READING THEM (`[data-navlink]`) — so the owner-only omission below
    needs no counterpart in JavaScript, and there is no second list for a
    role check to get wrong. Nothing in the client bundle knows what an
    owner is.

    THE ⋮ IS A <details>, NOT A BUTTON, and that is the no-JS story. The
    sheet is JS-only; below 640px these links are the only navigation
    there is, so a control that vanished without JS would strand a member
    on whatever page they landed on. With JS, site.ts preventDefault()s
    the summary's click and opens the sheet — the disclosure never opens.
    Without JS the click is not cancelled, `[open]` lands, and the CSS
    sibling rule drops the same links out as a stacked column. No `hidden`
    attribute anywhere, so no flash of the wrong nav on first paint. */}
<nav class="appnav">
  {/* The wordmark IS the Home link, so aria-current lives here rather
      than on a redundant "Home" text link beside it. The sheet still
      lists Home as a row — a 44px row costs nothing and a wordmark is a
      weak affordance on a phone. */}
  <a class="wordmark" href="/" aria-current={here === '/' ? 'page' : undefined}>localchune</a>

  <div class="navlinks">
    {/* M6c Task 2: "/" is now the home feed; the browse table moved to
        "/pool". */}
    <a data-navlink href="/pool" aria-current={here === '/pool' ? 'page' : undefined}>Pool</a>
    <a data-navlink href="/upload" aria-current={here === '/upload' ? 'page' : undefined}>Upload</a>
    <a data-navlink href="/uploads" aria-current={here === '/uploads' ? 'page' : undefined}>My uploads</a>
    {/* M6a Task 6. */}
    <a data-navlink href="/crates" aria-current={here.startsWith('/crates') || here.startsWith('/crate/') ? 'page' : undefined}>Crates</a>
    {/* M4 Task 7 — every member may read the merges feed. PRD §6: "wrong
        merges are cheap to undo only if someone notices", and one pair of
        eyes is not a lot of noticing. The Undo control inside is owner-only. */}
    <a data-navlink href="/merges" aria-current={here === '/merges' ? 'page' : undefined}>Merges</a>
    {/* Admin and Review are owner-only — OMITTED rather than shown disabled — a
        disabled link is a promise with no delivery date, and it tells a
        non-owner that an admin page exists. src/components/app-nav.test.ts
        pins both to this branch, including in the sheet. */}
    {m.role === 'owner' && (
      <a data-navlink data-navmeta={pending > 0 ? String(pending) : undefined} href="/review" aria-current={here === '/review' ? 'page' : undefined}>
        Review{pending > 0 && <span class="navbadge num">{pending}</span>}
      </a>
    )}
    {m.role === 'owner' && (
      <a data-navlink href="/admin" aria-current={here.startsWith('/admin') ? 'page' : undefined}>Admin</a>
    )}
    {/* Task 7: greets by username once claimed, falling back to email
        exactly as before for a member the middleware hasn't yet routed
        through /welcome. */}
    <span class="who">{m.username ?? m.email}</span>
    <span class="credits">{credits}</span>
    {/* data-astro-reload: /auth/signout reads no body, so it survives
        ClientRouter's multipart re-send today. It is opted out anyway, because
        the rule this repo now holds is "every POST form submits natively" —
        an invariant with two exceptions is one nobody can check. A sign-out
        also has to be a real document load: the response clears the auth
        cookies, and a full navigation is the only way every persisted island
        is torn down with them.

        The sheet's Sign out row calls requestSubmit() ON THIS FORM rather
        than fetching /auth/signout itself — requestSubmit fires a real
        submit event, so the opt-out above is still what ClientRouter
        reads, and there is exactly one sign-out code path. */}
    <form id="signout" method="post" action="/auth/signout" data-astro-reload><button type="submit" class="btn-secondary">Sign out</button></form>
  </div>

  {/* THE SEARCH ICON IS REAL NOW — and it stays an anchor, deliberately.

      It used to be a shortcut to /pool's `q` box and nothing else. With
      JS, site.ts cancels this click and opens the search overlay
      (src/lib/search-overlay.ts, loaded lazily on that first click).
      Without JS the click is not cancelled and it navigates to /pool,
      where the server-rendered filter form still works — the same
      no-JS story the nav's ⋮ tells with its <details>.

      A <button> here would have been a control that does nothing for a
      member with no JavaScript, which is the one thing this codebase
      refuses to ship (see `hidden` on every queue control). */}
  <a class="navsearch" href="/pool" aria-label="Search the pool"><Icon name="search" size={20} /></a>

  <details class="navmenu">
    <summary class="navmenu-btn" aria-label="Menu" aria-haspopup="dialog"><Icon name="kebab" size={20} /></summary>
  </details>
</nav>
