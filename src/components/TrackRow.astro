---
// src/components/TrackRow.astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
//
// One row. Artist and title come from the server (migration 11's
// display_* fallbacks) and are never re-derived here — search matches the
// server's strings.
//
// The play control is a LINK whose href is the track page: with JS the
// site script intercepts it and streams; without JS it navigates, which
// still works. The thumb <img> only renders when thumb.jpg exists — rows
// never load full-size art, and a missing thumb is a bordered empty box,
// never a broken image.
//
// M6a Task 7: two optional, backward-compatible additions for
// /crate/[id].astro's owner view — every existing caller (the pool table)
// leaves both at their defaults and renders byte-for-byte as before.
// `reorderable` puts `draggable`/`data-file-id` on the row itself, which is
// all site.ts's drag-to-reorder delegation needs to pick it up; the named
// `controls` slot lets the crate page append one trailing <td> (↑ ↓ ✕)
// without this component knowing anything about crates — it renders
// nothing when the caller passes no slotted content.
import Icon from './Icon.astro'
import KeyChip from './KeyChip.astro'
import QualityBadge from './QualityBadge.astro'
import { artThumb2xUrl, artThumbUrl, formatBpm, LIKE_ICON } from '../lib/track-format'
import { formatDuration } from '../lib/format'
import type { PoolTrack } from '../lib/pool-api'

interface Props { track: PoolTrack; reorderable?: boolean }
const { track, reorderable = false } = Astro.props
const artist = track.display_artist ?? 'Unknown artist'
const noBeat = track.bpm === null || track.bpm <= 0
const added = new Date(track.created_at).toISOString().slice(0, 10)
---
{/* data-play-row — OWNER, 2026-08-06: "list rows lose the play button;
    whole-row tap plays, matching the queue drawer's grammar." site.ts
    resolves a tap anywhere in here to the row's own `a.play`, and lets
    every inner control (♥, +Q, ⋮, the two title links, download, the
    crate picker) win its own tap. See playLinkFromTap in site.ts. */}
<tr
  class="trackrow"
  data-play-row
  draggable={reorderable ? 'true' : undefined}
  data-file-id={reorderable ? track.file_id : undefined}
>
  {/* ARTWORK LEADS, AND THE ARTWORK IS THE PLAY LINK. The `▶` used to be
      a bare text glyph 14x18px in its own cell — the audit's offender #2
      — beside a 28px thumb that did nothing. They are one control now:
      the link wraps the art and carries a play icon over it, so the
      visual affordance sits where a member's thumb already goes and the
      whole row is the hit area besides.

      The class, the href and the six data-* site.ts reads are what they
      were. site.ts scrapes `a.play` inside `[data-queue-list]` to build
      the list a play means, so the attributes belong on the LINK and not
      on the row: /track/[id] and /review render a play link with no row
      at all. Survive-list #7, unmoved.

      THE 44px BOX IS WHY THE 2x KEY MATTERS. The stored `thumb.jpg` is
      64px, so a 44 CSS px box on a 2x phone wants 88 real pixels and used
      to upscale. `thumb-2x.jpg` is 128px and covers it with room to
      spare — one srcset candidate, because `src` already names the 1x and
      repeating it would pay for a URL the browser has. A file uploaded
      since the last derivatives sweep has no 2x object; site.ts's
      `artFallback` drops the srcset on error rather than letting the
      browser abandon the element. */}
  <td class="art">
    <a
      class="play"
      href={`/track/${track.file_id}`}
      data-track-id={track.file_id}
      data-artist={track.display_artist ?? undefined}
      data-title={track.display_title}
      data-duration={track.duration_ms ?? undefined}
      data-bpm={track.bpm ?? undefined}
      data-key={track.key_camelot ?? undefined}
      aria-label={`Play ${track.display_title}`}
    >{track.has_thumb
      ? <img class="thumb" src={artThumbUrl(import.meta.env.PUBLIC_ART_BASE_URL, track.file_id)} srcset={`${artThumb2xUrl(import.meta.env.PUBLIC_ART_BASE_URL, track.file_id)} 2x`} alt="" width="44" height="44" loading="lazy" />
      : <span class="thumb-empty" aria-hidden="true"></span>}</a>
  </td>
  {/* `+Q` is play's companion (§4: "+ queue is a companion to play,
      everywhere play appears"). It is `hidden` in the markup and unhidden
      by site.ts, because a button that would do nothing without JS must
      not be visible without JS — the queue is client state and there is
      no server endpoint for it to fall back to.

      PERF TASK 2.2 — the button carries `data-file-id` AND NOTHING ELSE.
      It used to repeat artist/title/duration/bpm/key, which is five of
      the eight times the audit found artist and title serialised in one
      row, on every one of a hundred rows. site.ts's `+Q` delegation now
      reads the row's own `a.play` for that metadata. */}
  {/* THE THREE-DOT — the owner's "three dot menus", one per row. Below
      640px it is the row's whole control set: +Q, ♥, add-to-crate,
      download, the track page, and the eight metadata columns the card
      drops. site.ts builds it from THIS ROW — the cells for the values,
      the row's own controls for the actions — so the sheet adds no second
      copy of anything and no bytes beyond this button.

      `hidden` for the same reason `+Q` is: a sheet is client state with
      no server fallback, and a control that would do nothing without JS
      must not be visible without JS. Without JS the row still shows every
      control it always did, because the CSS that hides them is scoped to
      the JS-only case (see .rowmenu in global.css).

      THE BYTE BUDGET THAT KEPT THESE AS CHARACTERS WAS MEASURED ON THE
      WRONG AXIS. The note this replaces said `⋮` is three bytes against
      the kebab SVG's ~300, so a hundred rows cost 30 KB. The arithmetic
      was right and the axis was wrong: a hundred rows serialise a hundred
      BYTE-IDENTICAL copies, and DEFLATE emits the second through the
      hundredth as back-references.

      MEASURED, both states, real container renders of track-row.test.ts's
      own "realistic strings" fixture:

                          raw/row   100 rows raw   100 rows GZIPPED
        before (glyphs)     2,742        274 KB           2,585 B
        after  (icons)      4,155        416 KB           3,968 B
                          -------   ------------      -----------
                          +1,413        +142 KB          +1,383 B

      142 KB of raw growth costs 1.4 KB on the wire — ONE PERCENT of it.
      The old note predicted 30 KB and was out by a factor of twenty, for
      the single reason that it counted a byte a hundred times that the
      compressor sends once.

      1.4 KB is a real cost and it is worth paying here: the owner's
      directive is that no control draws itself with a character, and
      `queue-add` was written for this button — icons.ts says so in as
      many words ("Replaces the `+Q` text control"). track-row.test.ts
      guards the GZIPPED number as well as the raw one now, so the next
      person to weigh markup against bytes weighs the right ones. */}
  <td class="controls">
    <button
      type="button"
      class="queueadd btn-secondary btn-icon"
      hidden
      data-file-id={track.file_id}
      aria-label={`Add ${track.display_title} to the queue`}
    ><Icon name="queue-add" size={16} /></button>
    <button
      type="button"
      class="rowmenu"
      hidden
      aria-haspopup="dialog"
      aria-label={`More actions for ${track.display_title}`}
    ><Icon name="kebab" size={20} /></button>
  </td>
  {/* Task 8: artist and title are now independent columns — each still
      links to the track page, and the tag chips move to the title cell
      (they describe the track, not the artist). */}
  <td class="artist">
    <a href={`/track/${track.file_id}`}>{artist}</a>
  </td>
  <td class="title">
    <a href={`/track/${track.file_id}`}>{track.display_title}</a>
    {track.tags.length > 0 && (
      <span class="tags">
        {track.tags.map((tag) => <span class="tagchip">{tag}</span>)}
      </span>
    )}
  </td>
  <td class="bpm num" title={noBeat ? 'no beat detected' : undefined}>
    {formatBpm(track.bpm, track.ibi_std_ms)}
  </td>
  <td class="key">
    <KeyChip camelot={track.key_camelot} open={track.key_open} musical={track.key_musical} />
  </td>
  <td class="duration num">{formatDuration(track.duration_ms)}</td>
  <td class="quality">
    <QualityBadge tier={track.quality_tier} lossyAncestor={track.lossy_ancestor} measCutoffHz={track.meas_cutoff_hz} />
  </td>
  {/* M6c Task 3: links to the uploader's public profile. Unconditional —
      migration 17's fallback for a never-claimed member is
      split_part(email, '@', 1), which is not a routable username, and
      pool_tracks exposes no flag to tell the two apart here. That case
      404s at /member/[username] instead of silently not linking; accepted
      for the current ~ten-member scale (see M6c task-3 brief). */}
  <td class="uploader"><a href={`/member/${encodeURIComponent(track.uploader_name)}`}>{track.uploader_name}</a></td>
  <td class="added num">{added}</td>
  <td class="downloads num">{track.download_count}</td>
  {/* Task 3 (M6a): live now. A mini <form> POST, brutalist idiom (like
      tags.ts) so it still works with no JS — the route 303s back to
      Referer. With JS, site.ts's document-level `form.likeform` submit
      delegation intercepts it, calls org-api.ts's toggleLike() and swaps
      the glyph/count/aria-pressed in place instead of navigating. Filled
      heart when liked_by_me, empty otherwise — same convention Task 2
      established for the display-only cell this replaces. */}
  <td class="likes num">
    <form method="post" action={`/api/track/${track.file_id}/like`} class="likeform" data-astro-reload>
      <button
        type="submit"
        class="likebtn"
        data-file-id={track.file_id}
        aria-pressed={track.liked_by_me ? 'true' : 'false'}
        aria-label={`${track.liked_by_me ? 'Unlike' : 'Like'} ${track.display_title}`}
      ><span class="likeglyph"><Icon name={LIKE_ICON.name} size={LIKE_ICON.size} filled={track.liked_by_me} /></span> <span class="likecount">{track.like_count}</span></button>
    </form>
  </td>
  <td class="plays num">{track.play_count}</td>
  <td class="download">
    <a href={`/api/track/${track.file_id}/download`} aria-label={`Download ${track.display_title}`}><Icon name="download" size={20} /></a>
  </td>
  {/* Task 8: add-to-crate picker, every row, pool table and crate page
      alike — you can only add to a crate you OWN (crate_add's 42501
      check), never the one you might currently be viewing, so this is not
      slotted the way the crate page's owner-only move/remove controls are.
      Server-rendered contents are the no-JS fallback ONLY: a disclosure
      with one link to the track page, where the real no-JS `<select>` +
      submit form lives (see track/[id].astro). With JS, site.ts's
      document-level `toggle` delegation fetches the caller's own crates
      ONCE (GET /api/crates?mine=1) on first open of ANY picker on the
      page, then replaces `.cratepick-menu`'s contents in every picker —
      this one included — with real crate buttons plus an inline
      "new crate…" form. `data-file-id` on the <details> itself (not the
      row) is what lets that delegation work whether or not this row is
      also `reorderable`. */}
  <td class="addcrate">
    <details class="cratepick" data-file-id={track.file_id}>
      <summary class="btn-secondary btn-icon" aria-label={`Add ${track.display_title} to a crate`}><Icon name="crate" size={16} /></summary>
      <div class="cratepick-menu">
        <a href={`/track/${track.file_id}`}>manage on track page</a>
      </div>
    </details>
  </td>
  <slot name="controls" />
</tr>
