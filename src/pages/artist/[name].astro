---
// src/pages/artist/[name].astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
//
// EVERY ARTIST NAME IN THE APP IS A LINK, AND THIS IS WHERE THEY GO.
//
// ═══ INTERIM BY DESIGN, AND KEYED BY A STRING ═══
//
// There is no artist table and no artist id. `display_artist` is a derived
// text column (migration 11) — a tag lookup, falling back to the
// "Artist - Title" split of the filename — so an artist IS a string here,
// and this route is keyed by one.
//
// The data path is deliberately the smallest that works: `pool_list` with
// `p_q` set to the name, then `matchesArtist` narrowing the substring hits
// back to exact. No migration, no new RPC, no new grant. That matters for
// more than effort — `pool_list` is where the pool's visibility rules
// live (`state = 'stored'`, which excludes migration 33's tombstones,
// plus the active-member guard), so this page cannot drift from them. A
// bespoke artist query would be a second copy of those predicates, and
// the two would eventually disagree about who may see a deleted track.
//
// See `src/lib/pool-api.ts`'s artist block for the full rationale, the
// candidate-limit caveat, and the seam.
//
// ═══ KNOWN GAP: THIS LISTS FILES, NOT RECORDINGS (for POOL.1) ═══
//
// Migration 34 made "one row per recording" the rule on ranked surfaces,
// via `track_face_file()`. This page does NOT yet obey it: two stored
// encodes of one merged recording appear as two rows here. That is the
// same behaviour /pool has — migration 34's own comment says "pool_list()
// deliberately does NOT use this -- /pool lists files, by design" — so
// this page is consistent with a shipped surface rather than uniquely
// wrong. It is still not what the owner asked for, and here is precisely
// why it was not fixed in this commit rather than left unexplained.
//
// Three routes were evaluated against the real definitions on main:
//
//   1. COLLAPSE CLIENT-SIDE by `track_id`. `pool_list` returns track_id
//      but NOT `preferred_file_id`, and the face rule is "preferred if
//      it is stored, ELSE newest stored". Only the second arm can be
//      reproduced here, so this page would disagree with the feed and
//      search exactly when a pair has been merged — which is the only
//      case that matters. Migration 34 exists because two copies of this
//      rule diverge; adding a third, weaker copy is the anti-pattern it
//      names.
//
//   2. CALL `track_face_file()` DIRECTLY. It is `revoke ... from public,
//      anon, authenticated` / `grant ... to service_role`. This page runs
//      as the signed-in member. Not reachable, by design.
//
//   3. USE `search_tracks()` AS THE COLLAPSE AUTHORITY (it already
//      applies the rule). Rejected on three measured properties of its
//      body, all of which are correct for a human search box and wrong
//      for an exact-name listing:
//        - `least(greatest(coalesce(p_lim,10),1), 50)` — it CLAMPS TO 50
//          rows, where pool_list gives 200;
//        - its tokeniser routes a `^[0-9]{2,3}$` word to the BPM branch
//          and a `^(1[0-2]|[1-9])[ab]$` word to the key branch, so
//          `/artist/808 State` and `/artist/4B` would search for a tempo
//          and a Camelot key instead of a name;
//        - a `sc > 0.10` score floor drops rows that are real matches.
//      Any of the three silently loses an artist's tracks.
//
// So a correct collapse needs a SERVER-SIDE change, and the smallest one
// is a `p_collapse boolean default false` on `pool_list` whose predicate
// is migration 34's verbatim (`t.track_id is null or t.file_id =
// public.track_face_file(t.track_id)`), leaving /pool's per-file default
// untouched. That is a migration with revoke-first and pgTAP, which is
// POOL.1's job rather than this branch's. When it lands, one argument
// changes below and nothing else on this page does.
//
// ═══ THE M7 UPGRADE PATH ═══
//
// When canonical artist ids land (PRD M7), this page becomes a join and
// the route key becomes an id. Three things change and nothing else:
//
//   1. `artistHref()` in pool-api.ts stops encoding a name and starts
//      naming an id. Every link in the app is built through it — rows,
//      the track page, the player bar, the feed, the search overlay — so
//      they all move together, in one edit, with no call site touched.
//   2. `matchesArtist()` disappears into the query.
//   3. This frontmatter swaps `pool_list(p_q)` for the id-keyed call.
//
// The template below does not change at all: it is the shared card-row
// grammar, the same `TrackRow` every other list renders.
import Shell from '../../layouts/Shell.astro'
import TrackHead from '../../components/TrackHead.astro'
import TrackRow from '../../components/TrackRow.astro'
import {
  ARTIST_CANDIDATE_LIMIT, EMPTY_QUERY, matchesArtist, poolListArgs, type PoolTrack,
} from '../../lib/pool-api'

const { name } = Astro.params
// Guard before the RPC, same shape as member/[username].astro's: a missing
// or empty segment is a 404 here, never a bind-param mismatch in Postgres.
if (typeof name !== 'string' || name.trim() === '') {
  return new Response('Not found', { status: 404 })
}

const { data, error } = await Astro.locals.supabase.rpc(
  'pool_list',
  poolListArgs({ ...EMPTY_QUERY, q: name, sort: 'added_desc' }, null, ARTIST_CANDIDATE_LIMIT),
)
if (error) console.error('pool_list failed:', error.message)

// The RPC widened to a substring across artist/title/filename/tags; this
// narrows back to "the artist is exactly this".
const tracks = ((data ?? []) as PoolTrack[]).filter((t) => matchesArtist(t.display_artist, name))

// AN ARTIST WITH NO TRACKS IS NOT AN ARTIST. Unlike a member, there is no
// row anywhere that says this name exists — its only evidence is a track
// carrying it. So "no tracks" and "no such artist" are the same answer,
// and it is 404 rather than an empty page. An outage is different and
// must stay different: `error` is a failed query, not an absent artist,
// and rendering 404 for it would tell a member the act vanished.
if (error === null && tracks.length === 0) return new Response('Not found', { status: 404 })

/** The name as the tags spell it, not as the URL did. A member who typed
 *  `/artist/bicep` should see "Bicep" — the tracks are the authority on
 *  their own spelling, and `matchesArtist` ignored case to get here. */
const display = tracks[0]?.display_artist ?? name
---
<Shell title={`localchune — ${display}`}>
  <article class="artistdetail">
    {/* The same hero the member page takes, and the same ration: one
        resting shadow per view, on the subject. See `.memberhero`. */}
    <header class="memberhero">
      <h1>{display}</h1>
      <p class="explain">
        {tracks.length} {tracks.length === 1 ? 'track' : 'tracks'} in the pool
      </p>
    </header>

    <section class="crates-section">
      <h2>Tracks</h2>
      {error ? (
        // Distinct words from an empty result, per survive-list #16 — and
        // an empty result cannot reach here at all, it 404s above.
        <p class="explain">Could not load — try again.</p>
      ) : (
        <div class="tracktable">
          <table>
            <TrackHead />
            {/* `data-queue-list` makes the whole listing a queue: site.ts
                scrapes every `a.play` inside it in rendered order, so
                playing any row queues the artist's other tracks after it.
                Its value is the queue's `source_label` — what the drawer
                and the replace prompt call this queue — so it names the
                artist rather than the route. */}
            <tbody data-queue-list={display}>
              {tracks.map((t) => <TrackRow track={t} />)}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </article>
</Shell>
