// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
import SourceLink from '../components/SourceLink.astro'
import '../styles/global.css'
const error = Astro.url.searchParams.get('error_description')
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  {/* Same viewport-fit=cover as Shell.astro — /login renders without the
      Shell, so it needs its own copy or its safe-area rules evaluate to 0. */}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>localchune</title>
</head>
<body class="loginpage">
  <h1>localchune</h1>
  {error && <p role="alert"><strong>{error}</strong></p>}
  <button id="in" class="btn">Sign in with Google</button>
  <script>
    import { browserClient } from '../lib/supabase'
    document.getElementById('in')!.addEventListener('click', () => {
      browserClient().auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${location.origin}/auth/callback` },
      })
    })
  </script>
  <footer><SourceLink /></footer>
</body></html>
