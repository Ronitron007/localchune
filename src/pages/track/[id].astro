---
// src/pages/track/[id].astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
import Shell from '../../layouts/Shell.astro'
import Icon from '../../components/Icon.astro'
import KeyChip from '../../components/KeyChip.astro'
import QualityBadge from '../../components/QualityBadge.astro'
import { formatBytes, formatDuration } from '../../lib/format'
import { artMediumUrl, formatBpm } from '../../lib/track-format'
import { isUuid } from '../../lib/upload-api'
import { TERMINAL_FAILED_STATES, FAILURE_EXPLAIN, stateLabel, explainLastError } from '../../lib/file-state'
import type { CrateCard } from '../../lib/org-api'
import { formatTagDate, sourceLine, type Provenance } from '../../lib/provenance'

const { id } = Astro.params
// Guard before the RPC: a non-uuid path segment would otherwise reach
// Postgres and come back as 22P02 — a 500-shaped answer to a 404 question.
if (!isUuid(id)) return new Response('Not found', { status: 404 })

// PERF TASK 2.1 — pool_get and crate_list share no input, so they go in one
// stage. crate_list feeds the no-JS add-to-crate form far down the page (see
// its own comment below); awaiting it there made it a third round trip after
// this one and the conditional ingest_jobs read. Each result keeps its own
// error branch — a failed crate_list must render "could not load your
// crates", never an empty picker that reads as "you have none".
const rpc = Astro.locals.supabase.rpc.bind(Astro.locals.supabase)
const [{ data, error }, { data: cardsData, error: cardsError }] = await Promise.all([
  rpc('pool_get', { p_file_id: id }),
  rpc('crate_list'),
])
if (error) console.error('pool_get failed:', error.message)
const t = data?.[0]
// pool_get applies the visibility rule, so "not yours to see" and "does
// not exist" are the same answer — which is the point.
if (!t) return new Response('Not found', { status: 404 })

const artist = t.display_artist ?? 'Unknown artist'
const title = `${artist} — ${t.display_title}`
const hasArt = t.artwork_key !== null || t.thumb_key !== null
const num = (v: number | null, digits = 1, unit = '') =>
  v === null || v === undefined ? '—' : `${v.toFixed(digits)}${unit}`
// Migration 16: only the uploader gets the add/remove forms. Everyone
// pool-visible sees the chips — checked server-side, not hidden with CSS.
const isUploader = Astro.locals.member?.user_id === t.uploaded_by
// Migration 33: upload_delete() admits exactly two accounts — the uploader
// and the platform owner. The page renders the delete control for the same
// two, so the button and the RPC can never disagree about who may press it.
const isOwner = Astro.locals.member?.role === 'owner'

// Migration 16b: pool_get's own-uploader-any-state path now returns a row
// for a failed/quarantined/rejected/abandoned file too (previously it never
// could — pool_tracks INNER JOINed audio_analysis, and a file in one of
// these states never gets an analysis row). last_error lives on
// ingest_jobs, not pool_get's column set — read the same way
// src/lib/upload-api.ts's loadOwnedJob() already does, `user_id`-scoped so
// this can never leak another uploader's reason even if the state check
// above were ever wrong. Only fetched for the uploader, and only for a
// terminal-failed state — a 'stored' or 'needs_review' row never has one.
let lastError: string | null = null
if (isUploader && TERMINAL_FAILED_STATES.has(t.state)) {
  const { data: job, error: jobError } = await Astro.locals.supabase
    .from('ingest_jobs')
    .select('last_error')
    .eq('file_id', t.file_id)
    .eq('user_id', t.uploaded_by)
    .maybeSingle()
  if (jobError) console.error('ingest_jobs lookup failed:', jobError.message)
  lastError = (job?.last_error as string | null | undefined) ?? null
}

const tagsAction = `/api/track/${t.file_id}/tags`

// Task 8's no-JS add-to-crate fallback: TrackRow.astro's picker degrades
// to a link straight to THIS page (rendered without JS, opening the
// <details> just shows that link), and this is where the real form lives —
// a <select> cannot pick its own form's action, so the form always posts
// to add-dispatch.ts with crate_id as a second field. Every member reaching
// this page (middleware requires one) can see it; only crate_list's is_mine
// rows are offered, since crate_add rejects anything else with 42501 anyway.
// The call itself now runs in the first stage at the top of this file — its
// result is read here, where it is used.
if (cardsError) console.error('crate_list failed:', cardsError.message)
const myCrates = ((cardsData ?? []) as CrateCard[]).filter((c) => c.is_mine)

// Migration 20 — the owner's ask: "the tags you saw like the purchase
// date and purchased from itunes... cant we add these tags automatically
// for users to see". pool_get's `provenance` is the SQL-allowlisted
// projection of the file's embedded tags (provenance_from_tags()); the
// buyer-identity atoms an iTunes file carries (apID/account_id, ownr,
// xid) never leave the database, so nothing here needs to — or could —
// filter them. Each row below renders only when its value exists.
const prov: Provenance = t.provenance ?? {}
const source = sourceLine(prov, t.original_filename)
const released = formatTagDate(prov.release_date) ?? prov.release_date
---
<Shell title={`localchune — ${title}`}>
  <article class="trackdetail">
    <header>
      <h1>{title}</h1>
      {/* Migration 16b -- the owner's core ask #2, upload visibility: a
          failed file deserves a page saying what it is and why it failed,
          not a 404. Only rendered off the "stored" happy path, so a normal
          pool track's header looks exactly as it did before. The
          vocabulary (state label, one-line explanation) is the same
          src/lib/file-state.ts module /uploads.astro already uses — a file
          must never say one thing on one page and something else here. */}
      {t.state !== 'stored' && (
        <p class="statebanner">
          <span class="statechip">{stateLabel(t.state)}</span>
          {TERMINAL_FAILED_STATES.has(t.state) && (
            <>
              {' — '}
              <span class="explain">{FAILURE_EXPLAIN[t.state] ?? ''}</span>
              {lastError && (
                <>
                  {' — '}
                  {/* Same mapper as /uploads — the two pages must never
                      explain the same failure in two vocabularies. Raw
                      string in the tooltip, plain sentence in the text. */}
                  <span class="reason" title={lastError}>{explainLastError(lastError)}</span>
                </>
              )}
            </>
          )}
        </p>
      )}
      {/* The larger copy. Colour, unfiltered — content is not chrome.
          M7 note: if this art is ever Apple-sourced, the "Listen on
          Apple Music" badge is required HERE (PRD §8.1) — this page,
          never the table. */}
      {/* width/height RESERVE THE BOX — the audit's CLS finding on this
          page. They are the RENDERED box (256 CSS px square), deliberately
          not an intrinsic size: `medium.jpg` is built "long edge <= 512,
          aspect preserved" (scripts/art-derivatives.sh), so its real ratio
          is unknown to the server and attributes claiming 1:1 would be a
          lie the browser corrects the moment the bytes land — the exact
          shift this is meant to stop. global.css pins the same square with
          `aspect-ratio` and `object-fit: contain`, so a non-square cover is
          shown whole inside the reserved box instead of being stretched.
          `class="art"` and `data-art-file` both stay: site.ts's error
          handler reads them to fall back to the signed full-size original. */}
      {hasArt && (
        <img
          class="art"
          src={artMediumUrl(import.meta.env.PUBLIC_ART_BASE_URL, t.file_id)}
          data-art-file={t.file_id}
          width="256"
          height="256"
          alt={`Cover art for ${t.display_title}`}
        />
      )}
      {/* Final-review finding F1: this block was never state-gated. A
          failed/abandoned file's uploader can reach this page (migration
          16b) but has no object in R2 to play or download — Play silently
          fails and Download 302s into a raw R2 NoSuchKey page. The banner
          above already explains a non-stored state; no replacement UI is
          needed here. */}
      {t.state === 'stored' && (
        <>
          <div class="transport">
            {/* data-artist + data-title, NOT data-label — and this is a
                bug fix, not a rename. site.ts's `scrapeOne` reads
                dataset.artist and dataset.title and has never read
                dataset.label; `entryLabel()` rebuilds the "Artist — Title"
                string from the two. So this link, which carried only the
                joined label, queued an entry whose title was the empty
                string: playing from a track page put a BLANK NAME in the
                player bar, the drawer and the lock screen. /review's
                ComparePanel had the same shape and the same bug.

                `class="play playbtn"` — AN ADDITION, NOT A RENAME.
                survive-list #7: site.ts scrapes `a.play` and reads these
                six `data-*` off THIS element, so the class and every
                attribute stay exactly where they are. `.playbtn` is the
                second class that says "this one is a hero button, not a
                row's artwork".

                THE OWNER'S "the play button looks weird", root-caused.
                Phase 3 made the artwork the play control: `a.play` now
                draws a 22px scrim square and a CSS border-triangle in
                `::before`/`::after`, absolutely centred, because in a row
                the link WRAPS the thumbnail. This page has no thumbnail
                inside the link — it had the literal text "▶ Play" — so
                the scrim and the triangle painted straight over the
                label and it read "►▯ay". The page was never restyled
                (plan task 3.6 was not done) and the new rules found it.

                No glyph, on the owner's directive: iOS emoji-renders
                ▶/⏸/⏭, so every control this page owns takes the Phase 1
                inline SVG set instead. `<Icon>` is aria-hidden and the
                visible word is the accessible name. */}
            <a
              class="play playbtn"
              href={`/track/${t.file_id}`}
              data-track-id={t.file_id}
              data-artist={t.display_artist ?? undefined}
              data-title={t.display_title}
              data-duration={t.duration_ms ?? undefined}
              data-bpm={t.bpm ?? undefined}
              data-key={t.key_camelot ?? undefined}
            ><Icon name="play" size={16} /> Play</a>
            {/* Download is not transport — it takes an ordinary secondary
                tier, which is what gives it the 44px box it never had as a
                bare `↓` link. */}
            <a class="btn-secondary" href={`/api/track/${t.file_id}/download`}>
              <Icon name="download" size={16} /> Download
            </a>
          </div>
          {/* M6a Task 3, owner decision 2026-07-29 ("all metadata"): the
              full signal set together — like toggle, play count, download
              count. pool_get already returns all three (migration 26);
              this is rendering only, no new fetch. Same `form.likeform`
              class and markup shape as TrackRow.astro's pool-table cell,
              so site.ts's one document-level submit handler covers both.

              A <div>, AND THE <p> IT REPLACES IS THE WHOLE BUG. The owner
              reported "♥ 0 1 play 0 downloads" running together, a
              separator fix shipped for it (PR #41), and the owner reported
              the SAME line again — because the fix was never reaching this
              surface and nothing said so.

              `form` is on the HTML5 list of elements that imply `</p>`.
              The server sent `<p class="signals"><form …>`; the browser's
              parser closed the paragraph before the form, so the DOM here
              was an EMPTY `<p class="signals">` with the form and both
              `<span class="signal">` as its SIBLINGS. `.signals > * + *`
              then matched nothing: no dot, and not even the flex `gap`.
              `.stats` below carries only spans, was never auto-closed, and
              did show its dot — which is why one line on this page had
              separators and the line above it did not.

              A string assertion on the rendered HTML cannot see this: the
              server markup and the browser DOM disagree. The guard is
              src/lib/astro-html-nesting.test.ts, which parses the implied
              end tags the way a browser does, repo-wide. */}
          <div class="signals">
            <form method="post" action={`/api/track/${t.file_id}/like`} class="likeform" data-astro-reload>
              <button
                type="submit"
                class="likebtn"
                data-file-id={t.file_id}
                aria-pressed={t.liked_by_me ? 'true' : 'false'}
                aria-label={`${t.liked_by_me ? 'Unlike' : 'Like'} ${title}`}
              ><span class="likeglyph" aria-hidden="true">{t.liked_by_me ? '♥' : '♡'}</span> <span class="likecount">{t.like_count}</span></button>
            </form>
            <span class="signal">{t.play_count} play{t.play_count === 1 ? '' : 's'}</span>
            <span class="signal">{t.download_count} download{t.download_count === 1 ? '' : 's'}</span>
          </div>
        </>
      )}
      {/* Migration 15b: download_count is a real counter (track_stats),
          upload_count is a live count(*) over file_claims — see that
          migration's header for why these are two different mechanisms
          under one format-agnostic-by-design plan. */}
      {/* The separator is no longer typed here. Every count run in the app
          (.signals, .feedrow-meta, this one) gets its middle dot from one
          generated rule in global.css — see the "COUNT RUNS" block there
          for the owner report that caused it. Each count is its own
          element so that rule has an adjacent sibling to hang the dot on.

          A <div> for the same reason `.signals` above is one. This run
          carries only spans, was never auto-closed, and did render its dot
          — which is exactly how one line on this page had separators while
          the line above it did not. Both count runs are now the element
          that cannot be closed out from under them. */}
      <div class="stats">
        <span class="signal">downloaded {t.download_count} time{t.download_count === 1 ? '' : 's'}</span>
        <span class="signal">brought by {t.upload_count} member{t.upload_count === 1 ? '' : 's'}</span>
      </div>
    </header>

    {/* Migration 16 — owner's verbatim ask: "give the uploader an ability
        to add tags... at any point of time for all the tracks that he's
        uploaded." Editable at ANY file state, uploader-only, brutalist
        idiom — plain <form> POSTs to /api/track/[id]/tags, no island. The
        remove form's tag_key field carries the tag's DISPLAY text, not a
        separately-fetched key: tag_remove re-derives the same normalised
        key from it (trim/casefold/collapse), so no extra column is needed
        just to round-trip a delete. */}
    <section class="tags">
      <h2>Tags</h2>
      {t.tags.length === 0 && <p class="explain">No tags yet.</p>}
      <ul class="tageditor">
        {t.tags.map((tag: string) => (
          <li>
            <span class="tagchip">{tag}</span>
            {isUploader && (
              <form class="tagform" method="post" action={tagsAction} data-astro-reload>
                <input type="hidden" name="intent" value="remove" />
                <input type="hidden" name="tag_key" value={tag} />
                {/* The owner's icon directive: no text glyph on a control.
                    `×` is U+00D7, which iOS is free to render as emoji;
                    `close` is the same mark from the Phase 1 SVG set and
                    cannot be. The aria-label was already carrying the
                    accessible name, so nothing moves. */}
                <button type="submit" class="btn-danger btn-icon" aria-label={`Remove tag ${tag}`}><Icon name="close" size={14} /></button>
              </form>
            )}
          </li>
        ))}
      </ul>
      {isUploader && (
        <form class="tagform" method="post" action={tagsAction} data-astro-reload>
          <label>
            <span class="sr-only">Add a tag</span>
            <input type="text" name="tag" maxlength="32" placeholder="add a tag" required />
          </label>
          <button type="submit" class="btn">add tag</button>
        </form>
      )}
    </section>

    {/* Task 8's no-JS add-to-crate fallback — every member, not just the
        uploader (crate_add's own ownership check is on the CRATE, not the
        file). Gated the same as the transport/signals block above: a
        non-stored file has nothing worth crating yet. A plain <select> +
        submit form cannot put the chosen crate id into its own action
        attribute, so this always posts to the fixed add-dispatch.ts
        endpoint with crate_id as a second field — see that route's header
        comment. With JS, this section is never reached: TrackRow.astro's
        picker on THIS row (rendered as part of the pool table/crate page
        elsewhere) or the track page's own `.cratepick` handles it inline
        instead, and site.ts's picker never touches this form. */}
    {t.state === 'stored' && (
      <section class="addcrate">
        <h2>Add to a crate</h2>
        {myCrates.length === 0 ? (
          <p class="explain">You have no crates yet. <a href="/crates">Create one</a>.</p>
        ) : (
          <form method="post" action="/api/crate/add-dispatch" class="addcrateform" data-astro-reload>
            <input type="hidden" name="file_id" value={t.file_id} />
            <label>
              <span class="sr-only">Choose a crate</span>
              <select name="crate_id" required>
                {myCrates.map((c) => <option value={c.id}>{c.name}</option>)}
              </select>
            </label>
            <button type="submit" class="btn">Add to crate</button>
          </form>
        )}
      </section>
    )}

    <section class="identity">
      <h2>Identity</h2>
      <dl>
        <dt>Artist</dt><dd>{artist}</dd>
        <dt>Title</dt><dd>{t.display_title}</dd>
        <dt>Filename</dt><dd>{t.original_filename}</dd>
      </dl>
      {/* M7 slot: canonical artist/title/album/label from the catalogue
          match. Nothing until then — no placeholder, no empty box. */}
    </section>

    <section class="analysis">
      <h2>Analysis</h2>
      <dl>
        <dt>BPM</dt>
        <dd class="num" title={t.bpm === null || t.bpm <= 0 ? 'no beat detected' : `${t.beat_count} beats on the grid`}>
          {formatBpm(t.bpm, t.ibi_std_ms)}
        </dd>
        <dt>Key</dt>
        <dd><KeyChip camelot={t.key_camelot} open={t.key_open} musical={t.key_musical} /></dd>
        <dt title="What each key-detection profile answered. Disagreement between them is the honest signal that the key is ambiguous.">
          Other key profiles
        </dt>
        <dd>{t.key_alt_profiles
              ? Object.entries(t.key_alt_profiles).map(([p, k]) => `${p}: ${k}`).join(' · ')
              : '—'}</dd>
        <dt>Length</dt><dd class="num">{formatDuration(t.duration_ms)}</dd>
        <dt>Integrated loudness</dt><dd class="num">{num(t.integrated_lufs, 1, ' LUFS')}</dd>
        <dt>Loudness range</dt><dd class="num">{num(t.lra_lu, 1, ' LU')}</dd>
        <dt>True peak</dt><dd class="num">{num(t.true_peak_dbtp, 1, ' dBTP')}</dd>
        <dt>ReplayGain</dt><dd class="num">{num(t.replaygain_db, 1, ' dB')}</dd>
      </dl>
    </section>

    <section class="forensics">
      <h2>Source quality</h2>
      <p><QualityBadge tier={t.quality_tier} lossyAncestor={t.lossy_ancestor} measCutoffHz={t.meas_cutoff_hz} /></p>
      <dl>
        <dt>Container</dt><dd>{t.container ?? '—'}</dd>
        <dt>Size</dt><dd class="num">{formatBytes(t.byte_size)}</dd>
        <dt>Measured cutoff</dt>
        <dd class="num">{t.meas_cutoff_hz ? `${(t.meas_cutoff_hz / 1000).toFixed(1)} kHz` : '—'}</dd>
        <dt title="A suspicion proxy, not a verdict. Loud modern masters clip on purpose.">
          Clipped samples
        </dt>
        <dd class="num">{num(t.clipped_pct, 2, ' %')}</dd>
      </dl>
    </section>

    <section class="provenance">
      <h2>Provenance</h2>
      <dl>
        {source && <><dt>Source</dt><dd>{source}</dd></>}
        {prov.copyright && <><dt>Copyright</dt><dd>{prov.copyright}</dd></>}
        {prov.label && <><dt>Label</dt><dd>{prov.label}</dd></>}
        {released && <><dt>Released</dt><dd class="num">{released}</dd></>}
        {prov.genre && <><dt>Genre</dt><dd>{prov.genre}</dd></>}
        {prov.encoder && <><dt>Encoder</dt><dd>{prov.encoder}</dd></>}
        <dt>Uploaded by</dt><dd>{t.uploader_name}</dd>
        <dt>Batch</dt><dd>{t.batch_label ?? t.batch_id}</dd>
        <dt>Added</dt><dd class="num">{new Date(t.created_at).toISOString().slice(0, 10)}</dd>
        <dt>Analysed</dt>
        <dd class="num">{t.analyzed_at ? `${new Date(t.analyzed_at).toISOString().slice(0, 16).replace('T', ' ')} (${t.analysis_version})` : '—'}</dd>
        <dt>Also contributed by</dt>
        <dd>{(t.claim_names ?? []).join(', ') || '—'}</dd>
      </dl>
      {/* M4 slot: the duplicate-review verdict and the merge/undo history. */}
    </section>

    {/* ------------------------------------------------------------------
        Migration 33. The uploader deletes their own upload.

        SERVER-RENDERED CONDITIONAL, never hidden with CSS — the same rule
        the tag forms above follow. A member who is not the uploader gets
        no markup at all, so there is nothing to un-hide in devtools and
        nothing for a screen reader to read out and then refuse.

        GATED ON 'stored' as well as on identity, because upload_delete()
        refuses every other state (a pending upload is /api/upload/abort's
        job, a failed one already holds no reachable bytes). Rendering the
        button outside that state would be rendering a button whose only
        possible outcome is a 409.

        The owner sees it too — is_owner() is the one account other than
        the uploader that upload_delete() admits — but with copy that does
        not call someone else's file "your upload".

        data-confirm drives the delegated confirm() in site.ts. An inline
        handler attribute cannot serve here: it trips Cloudflare's API WAF
        on deploy and the upload 403s with a challenge page (see
        crate/[id].astro). With JS off the form submits unguarded — the
        guard is a courtesy against a stray click, not the security
        boundary. The boundary is upload_delete()'s in-body auth check.

        data-astro-reload is mandatory: without it ClientRouter re-sends
        the body as multipart, the route's urlencoded branch is missed and
        the router navigates to the POST-only URL. src/lib/
        astro-forms.test.ts fails the build if it is ever dropped.
        ------------------------------------------------------------------ */}
    {t.state === 'stored' && (isUploader || isOwner) && (
      <section class="dangerzone">
        <h2>{isUploader ? 'Your upload' : 'Owner controls'}</h2>
        <p class="explain">
          {isUploader
            ? 'Deleting removes the audio file from the pool for everyone, permanently. Your contribution total does not change.'
            : `This file was uploaded by ${t.uploader_name}. As the platform owner you can remove it.`}
        </p>
        <form
          method="post"
          action={`/api/track/${t.file_id}/delete`}
          class="deleteform"
          data-confirm={isUploader
            ? `Delete your upload of ${t.display_title}? This removes the file for everyone, permanently.`
            : `Delete ${t.uploader_name}'s upload of ${t.display_title}? This removes the file for everyone, permanently.`}
          data-astro-reload
        >
          <button type="submit" class="btn-danger">Delete this upload</button>
        </form>
      </section>
    )}
  </article>
</Shell>
