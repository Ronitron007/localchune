---
// src/pages/track/[id].astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
import Shell from '../../layouts/Shell.astro'
import KeyChip from '../../components/KeyChip.astro'
import QualityBadge from '../../components/QualityBadge.astro'
import { formatBytes, formatDuration } from '../../lib/format'
import { formatBpm } from '../../lib/track-format'
import { isUuid } from '../../lib/upload-api'
import { TERMINAL_FAILED_STATES, FAILURE_EXPLAIN, stateLabel } from '../../lib/file-state'

const { id } = Astro.params
// Guard before the RPC: a non-uuid path segment would otherwise reach
// Postgres and come back as 22P02 — a 500-shaped answer to a 404 question.
if (!isUuid(id)) return new Response('Not found', { status: 404 })

const { data, error } = await Astro.locals.supabase.rpc('pool_get', { p_file_id: id })
if (error) console.error('pool_get failed:', error.message)
const t = data?.[0]
// pool_get applies the visibility rule, so "not yours to see" and "does
// not exist" are the same answer — which is the point.
if (!t) return new Response('Not found', { status: 404 })

const artist = t.display_artist ?? 'Unknown artist'
const title = `${artist} — ${t.display_title}`
const hasArt = t.artwork_key !== null || t.thumb_key !== null
const num = (v: number | null, digits = 1, unit = '') =>
  v === null || v === undefined ? '—' : `${v.toFixed(digits)}${unit}`
// Migration 16: only the uploader gets the add/remove forms. Everyone
// pool-visible sees the chips — checked server-side, not hidden with CSS.
const isUploader = Astro.locals.member?.user_id === t.uploaded_by

// Migration 16b: pool_get's own-uploader-any-state path now returns a row
// for a failed/quarantined/rejected/abandoned file too (previously it never
// could — pool_tracks INNER JOINed audio_analysis, and a file in one of
// these states never gets an analysis row). last_error lives on
// ingest_jobs, not pool_get's column set — read the same way
// src/lib/upload-api.ts's loadOwnedJob() already does, `user_id`-scoped so
// this can never leak another uploader's reason even if the state check
// above were ever wrong. Only fetched for the uploader, and only for a
// terminal-failed state — a 'stored' or 'needs_review' row never has one.
let lastError: string | null = null
if (isUploader && TERMINAL_FAILED_STATES.has(t.state)) {
  const { data: job, error: jobError } = await Astro.locals.supabase
    .from('ingest_jobs')
    .select('last_error')
    .eq('file_id', t.file_id)
    .eq('user_id', t.uploaded_by)
    .maybeSingle()
  if (jobError) console.error('ingest_jobs lookup failed:', jobError.message)
  lastError = (job?.last_error as string | null | undefined) ?? null
}

const tagsAction = `/api/track/${t.file_id}/tags`
---
<Shell title={`localchune — ${title}`}>
  <article class="trackdetail">
    <header>
      <h1>{title}</h1>
      {/* Migration 16b -- the owner's core ask #2, upload visibility: a
          failed file deserves a page saying what it is and why it failed,
          not a 404. Only rendered off the "stored" happy path, so a normal
          pool track's header looks exactly as it did before. The
          vocabulary (state label, one-line explanation) is the same
          src/lib/file-state.ts module /uploads.astro already uses — a file
          must never say one thing on one page and something else here. */}
      {t.state !== 'stored' && (
        <p class="statebanner">
          <span class="statechip">{stateLabel(t.state)}</span>
          {TERMINAL_FAILED_STATES.has(t.state) && (
            <>
              {' — '}
              <span class="explain">{FAILURE_EXPLAIN[t.state] ?? ''}</span>
              {lastError && (
                <>
                  {' — '}
                  <span class="reason">{lastError}</span>
                </>
              )}
            </>
          )}
        </p>
      )}
      {/* The larger copy. Colour, unfiltered — content is not chrome.
          M7 note: if this art is ever Apple-sourced, the "Listen on
          Apple Music" badge is required HERE (PRD §8.1) — this page,
          never the table. */}
      {hasArt && (
        <img class="art" src={`/api/track/${t.file_id}/art?full=1`} alt={`Cover art for ${t.display_title}`} />
      )}
      <p class="transport">
        <a
          class="play"
          href={`/track/${t.file_id}`}
          data-track-id={t.file_id}
          data-label={title}
        >▶ Play</a>
        {' '}
        <a href={`/api/track/${t.file_id}/download`}>↓ Download</a>
      </p>
      {/* Migration 15b: download_count is a real counter (track_stats),
          upload_count is a live count(*) over file_claims — see that
          migration's header for why these are two different mechanisms
          under one format-agnostic-by-design plan. */}
      <p class="stats">
        downloaded {t.download_count} time{t.download_count === 1 ? '' : 's'}
        {' · '}
        brought by {t.upload_count} member{t.upload_count === 1 ? '' : 's'}
      </p>
    </header>

    {/* Migration 16 — owner's verbatim ask: "give the uploader an ability
        to add tags... at any point of time for all the tracks that he's
        uploaded." Editable at ANY file state, uploader-only, brutalist
        idiom — plain <form> POSTs to /api/track/[id]/tags, no island. The
        remove form's tag_key field carries the tag's DISPLAY text, not a
        separately-fetched key: tag_remove re-derives the same normalised
        key from it (trim/casefold/collapse), so no extra column is needed
        just to round-trip a delete. */}
    <section class="tags">
      <h2>Tags</h2>
      {t.tags.length === 0 && <p class="explain">No tags yet.</p>}
      <ul class="tageditor">
        {t.tags.map((tag: string) => (
          <li>
            <span class="tagchip">{tag}</span>
            {isUploader && (
              <form class="tagform" method="post" action={tagsAction}>
                <input type="hidden" name="intent" value="remove" />
                <input type="hidden" name="tag_key" value={tag} />
                <button type="submit" aria-label={`Remove tag ${tag}`}>×</button>
              </form>
            )}
          </li>
        ))}
      </ul>
      {isUploader && (
        <form class="tagform" method="post" action={tagsAction}>
          <label>
            <span class="sr-only">Add a tag</span>
            <input type="text" name="tag" maxlength="32" placeholder="add a tag" required />
          </label>
          <button type="submit">add tag</button>
        </form>
      )}
    </section>

    <section class="identity">
      <h2>Identity</h2>
      <dl>
        <dt>Artist</dt><dd>{artist}</dd>
        <dt>Title</dt><dd>{t.display_title}</dd>
        <dt>Filename</dt><dd>{t.original_filename}</dd>
      </dl>
      {/* M7 slot: canonical artist/title/album/label from the catalogue
          match. Nothing until then — no placeholder, no empty box. */}
    </section>

    <section class="analysis">
      <h2>Analysis</h2>
      <dl>
        <dt>BPM</dt>
        <dd class="num" title={t.bpm === null || t.bpm <= 0 ? 'no beat detected' : `${t.beat_count} beats on the grid`}>
          {formatBpm(t.bpm, t.ibi_std_ms)}
        </dd>
        <dt>Key</dt>
        <dd><KeyChip camelot={t.key_camelot} open={t.key_open} musical={t.key_musical} /></dd>
        <dt title="What each key-detection profile answered. Disagreement between them is the honest signal that the key is ambiguous.">
          Other key profiles
        </dt>
        <dd>{t.key_alt_profiles
              ? Object.entries(t.key_alt_profiles).map(([p, k]) => `${p}: ${k}`).join(' · ')
              : '—'}</dd>
        <dt>Length</dt><dd class="num">{formatDuration(t.duration_ms)}</dd>
        <dt>Integrated loudness</dt><dd class="num">{num(t.integrated_lufs, 1, ' LUFS')}</dd>
        <dt>Loudness range</dt><dd class="num">{num(t.lra_lu, 1, ' LU')}</dd>
        <dt>True peak</dt><dd class="num">{num(t.true_peak_dbtp, 1, ' dBTP')}</dd>
        <dt>ReplayGain</dt><dd class="num">{num(t.replaygain_db, 1, ' dB')}</dd>
      </dl>
    </section>

    <section class="forensics">
      <h2>Source quality</h2>
      <p><QualityBadge tier={t.quality_tier} lossyAncestor={t.lossy_ancestor} measCutoffHz={t.meas_cutoff_hz} /></p>
      <dl>
        <dt>Container</dt><dd>{t.container ?? '—'}</dd>
        <dt>Size</dt><dd class="num">{formatBytes(t.byte_size)}</dd>
        <dt>Measured cutoff</dt>
        <dd class="num">{t.meas_cutoff_hz ? `${(t.meas_cutoff_hz / 1000).toFixed(1)} kHz` : '—'}</dd>
        <dt title="A suspicion proxy, not a verdict. Loud modern masters clip on purpose.">
          Clipped samples
        </dt>
        <dd class="num">{num(t.clipped_pct, 2, ' %')}</dd>
      </dl>
    </section>

    <section class="provenance">
      <h2>Provenance</h2>
      <dl>
        <dt>Uploaded by</dt><dd>{t.uploader_name}</dd>
        <dt>Batch</dt><dd>{t.batch_label ?? t.batch_id}</dd>
        <dt>Added</dt><dd class="num">{new Date(t.created_at).toISOString().slice(0, 10)}</dd>
        <dt>Analysed</dt>
        <dd class="num">{t.analyzed_at ? `${new Date(t.analyzed_at).toISOString().slice(0, 16).replace('T', ' ')} (${t.analysis_version})` : '—'}</dd>
        <dt>Also contributed by</dt>
        <dd>{(t.claim_names ?? []).join(', ') || '—'}</dd>
      </dl>
      {/* M4 slot: the duplicate-review verdict and the merge/undo history. */}
    </section>
  </article>
</Shell>
