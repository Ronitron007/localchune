// worker includes Essentia. LICENSE explains why.

import Shell from '../../layouts/Shell.astro'
import AllowlistForm from '../../components/AllowlistForm'
import RevokeButton from '../../components/RevokeButton'
import { formatBytes } from '../../lib/format'

// Astro.locals.supabase — reuse the cookie-bound client middleware already
// built for this request, not a second serverClient(cookies, request); see
// the API note in the allowlist API route above for why that matters.
// PERF TASK 2.1 — one stage. The two share no input; each keeps its own
// error branch, because a failed member_storage must not read as "nobody
// has stored anything".
const rpc = Astro.locals.supabase.rpc.bind(Astro.locals.supabase)
const [{ data: rows, error }, { data: storageRows, error: storageErr }] = await Promise.all([
  rpc('admin_members'),
  // member_storage() (migration 08) returns every member's row for the
  // owner, and only the caller's own row for anyone else — the
  // RLS-equivalent filter lives inside the function itself, not here.
  rpc('member_storage'),
])
if (error) console.error('admin_members failed:', error.message)
if (storageErr) console.error('member_storage failed:', storageErr.message)
---
<Shell title="localchune — members">
  <h1>Members</h1>
  <AllowlistForm client:load />
  <table>
    <thead><tr><th>Email</th><th>Username</th><th>Role</th><th>Credits</th><th>Signed up</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      {(rows ?? []).map((r: any) => (
        <tr>
          <td>{r.email}</td><td>{r.username ?? '—'}</td><td>{r.role}</td>
          <td>{r.signed_up ? r.credits : '—'}</td>
          <td>{r.signed_up ? 'yes' : 'pending'}</td>
          <td>{r.revoked_at ? 'revoked' : 'active'}</td>
          <td>
            {r.role === 'owner' ? (
              '—'
            ) : r.revoked_at ? (
              'revoked'
            ) : (
              <RevokeButton email={r.email} client:load />
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h1>Storage</h1>
  <table>
    <thead><tr><th>Email</th><th>Occupying</th><th>Contributed</th></tr></thead>
    <tbody>
      {(storageRows ?? []).map((s: any) => (
        <tr>
          <td>{s.member_email}</td>
          <td>{formatBytes(s.occupying_bytes)} ({s.occupying_files} files)</td>
          <td>{formatBytes(s.contributed_bytes)} ({s.contributed_files} files)</td>
        </tr>
      ))}
    </tbody>
  </table>
</Shell>
