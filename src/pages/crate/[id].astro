---
// src/pages/crate/[id].astro
// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.
//
// One crate: its tracks, playable, in order. crate_get() (migration 27)
// has no crate-metadata columns of its own (name/is_public/owner) — only
// crate_list() carries those, alongside the is_mine flag this page needs
// to decide "owner controls or read-only" — so this page calls BOTH RPCs,
// the same pair /crates.astro and this page's own owner-controls forms
// already depend on.
//
// A missing row in crate_list() (the crate does not exist, or it exists
// and is private and not the caller's) and a 42501 from crate_get() are
// the SAME answer, mapped to the SAME 404 — a probing visitor cannot tell
// "no such crate" from "exists, not yours to see" apart. See migration
// 20's crate_get comment: the database's own answer is 42501 either way;
// only the HTTP status is chosen here.
import Shell from '../../layouts/Shell.astro'
import TrackHead from '../../components/TrackHead.astro'
import TrackRow from '../../components/TrackRow.astro'
import Icon from '../../components/Icon.astro'
import { crateItemToPoolTrack, formatCrateMeta, type CrateCard, type CrateItem } from '../../lib/org-api'
import { isUuid } from '../../lib/upload-api'

const { id } = Astro.params
if (!isUuid(id)) return new Response('Not found', { status: 404 })

// PERF TASK 2.1 — one stage. crate_get takes the id from the URL, not from
// crate_list's result, so only the 404 gate below depended on the order.
// For a crate that does not exist (or is not the caller's) the extra
// crate_get is one wasted round trip on a request that 404s; every real
// view saves a whole sequential stage, which is 60–165 ms.
const rpc = Astro.locals.supabase.rpc.bind(Astro.locals.supabase)
const [{ data: cardsData, error: listError }, { data: rowsData, error: getError }] =
  await Promise.all([
    rpc('crate_list'),
    rpc('crate_get', { p_crate: id }),
  ])
if (listError) console.error('crate_list failed:', listError.message)
const meta = ((cardsData ?? []) as CrateCard[]).find((c) => c.id === id)
if (!meta) return new Response('Not found', { status: 404 })

// A non-42501 failure here (dropped connection, Postgres unreachable) must
// not render the same "no tracks" empty state a genuinely empty crate
// gets — that reads as data loss during an outage. 42501 already returns
// 404 above; anything else just flags the outage message below.
let loadFailed = false
if (getError) {
  if (getError.code === '42501') return new Response('Not found', { status: 404 })
  console.error('crate_get failed:', getError.message)
  loadFailed = true
}
const items = (rowsData ?? []) as CrateItem[]
const isOwner = meta.is_mine

// The fifteen <th> live in TrackHead.astro now — this page, /member and
// /artist all held their own copy, and TrackRow renders exactly fifteen
// cells, so a divergence shears every label one column sideways.
---
<Shell title={`localchune — ${meta.name}`}>
  <article class="cratedetail">
    <header class="cratehead">
      <h1>{meta.name}</h1>
      <p class="explain">
        {/* M6c Task 3: owner_name links to their member page. Unconditional,
            same never-claimed-member caveat as TrackRow.astro's uploader
            link — see that comment. */}
        {!isOwner && <>by <a href={`/member/${encodeURIComponent(meta.owner_name)}`}>{meta.owner_name}</a> · </>}
        {formatCrateMeta(meta)}
        {!meta.is_public && <span class="privatechip">PRIVATE</span>}
      </p>

      {/* M6b: play the crate, or append it. Two buttons, side by side,
          because that adjacency is what makes "play REPLACES, + queue
          APPENDS" learnable without documentation (§4). Both are
          `type="button"` and `hidden` until site.ts unhides them: the queue
          is client state with no server endpoint behind it, so without JS
          there is nothing for either to do and neither should be visible.
          Playing reads the rendered rows straight out of the table below —
          no fetch — and appending onto a nearly-full queue reports its own
          truncation into the player's status region. */}
      {items.length > 0 && (
        <p class="cratetransport">
          <button
            type="button"
            class="crateplay btn"
            hidden
            data-crate-id={id}
            data-crate-name={meta.name}
          ><Icon name="play" size={16} /> PLAY</button>
          <button
            type="button"
            class="queueadd btn-secondary"
            hidden
            data-crate-id={id}
            data-crate-name={meta.name}
          >+ QUEUE</button>
        </p>
      )}

      {/* Owner-only management forms — plain <form> POSTs, brutalist
          idiom, same shape as /crates.astro's create form and the track
          page's tag editor: every one of these works with no JS. */}
      {isOwner && (
        <div class="cratemanage">
          <form method="post" action={`/api/crate/${id}/rename`} class="renameform" data-astro-reload>
            <label>
              <span class="sr-only">Rename crate</span>
              <input type="text" name="name" value={meta.name} maxlength="80" required />
            </label>
            <button type="submit" class="btn-secondary">Rename</button>
          </form>
          <form method="post" action={`/api/crate/${id}/public`} class="publicform" data-astro-reload>
            <input type="hidden" name="public" value={meta.is_public ? 'false' : 'true'} />
            <button type="submit" class="btn-secondary">
              {meta.is_public ? 'Make private' : 'Make public'}
            </button>
          </form>
          {/* data-confirm drives a delegated confirm() in the site script —
              an inline handler attribute trips Cloudflare's API WAF on
              deploy (the upload 403s with a challenge page). Same
              semantics: with JS off, either form submits unguarded; the
              guard is a courtesy against a stray click, not a security
              boundary. */}
          <form
            method="post"
            action={`/api/crate/${id}/delete`}
            class="deleteform"
            data-confirm="Delete this crate? This cannot be undone."
            data-astro-reload
          >
            <button type="submit" class="btn-danger">Delete crate</button>
          </form>
        </div>
      )}
    </header>

    {items.length === 0 ? (
      <p class="explain">
        {loadFailed
          ? 'Could not load — try again.'
          : isOwner ? 'No tracks in this crate yet.' : 'This crate is empty.'}
      </p>
    ) : (
      <div class="tracktable">
      {/* `.tracktable` is the pool's wrapper, and this table never had it —
          so at 390px the crate stayed a 1,439px-wide table and its controls
          cell, drag handle included, sat ~1,290px off the right edge of the
          viewport. A touch reorder whose handle cannot be touched is the
          exact hollow outcome the library shootout rejected pragmatic-dnd
          for. This is the SMALLEST borrow of task 3.5 that makes the feature
          real on a phone: the same one DOM / two grammars rule the pool
          already uses, unchanged, plus one grid slot for the controls cell
          the pool does not have. 3.5 can replace it wholesale. */}
      <table>
        <TrackHead manage={isOwner} />
        {/* `data-reorder` carries the crate id itself — site.ts's drag
            delegation reads it straight off the container instead of
            parsing the page URL, so the enhancement works regardless of
            how this page is ever routed. Absent entirely for a non-owner:
            read-only list, no drag, no controls cell below. */}
        <tbody data-reorder={isOwner ? id : undefined} data-queue-list={meta.name}>
          {items.map((item, idx) => (
            <TrackRow track={crateItemToPoolTrack(item)} reorderable={isOwner}>
              {isOwner && (
                <td class="cratecontrols" slot="controls">
                  {/* The grab affordance, and the ONLY thing a drag may start
                      from. Without a handle the whole row is the drag surface,
                      and on a phone a finger dragged down a list means "scroll"
                      far more often than it means "reorder" — the library
                      cannot tell which until it has already swallowed the
                      gesture. Server-rendered rather than written by site.ts
                      because it is markup, not behaviour: with JS off it is an
                      inert 44px square that says what it is, and the ↑/↓ forms
                      beside it still work. */}
                  <span class="cratedrag" aria-hidden="true" title="Drag to reorder">
                    <Icon name="drag" size={16} />
                  </span>
                  <form method="post" action={`/api/crate/${id}/move`} class="moveform" data-astro-reload>
                    <input type="hidden" name="file_id" value={item.file_id} />
                    <input type="hidden" name="dir" value="up" />
                    <button
                      type="submit"
                      class="btn-secondary"
                      aria-label={`Move ${item.display_title} up`}
                      disabled={idx === 0}
                    ><Icon name="move-up" size={16} /></button>
                  </form>
                  <form method="post" action={`/api/crate/${id}/move`} class="moveform" data-astro-reload>
                    <input type="hidden" name="file_id" value={item.file_id} />
                    <input type="hidden" name="dir" value="down" />
                    <button
                      type="submit"
                      class="btn-secondary"
                      aria-label={`Move ${item.display_title} down`}
                      disabled={idx === items.length - 1}
                    ><Icon name="move-down" size={16} /></button>
                  </form>
                  <form method="post" action={`/api/crate/${id}/remove`} class="removeform" data-astro-reload>
                    <input type="hidden" name="file_id" value={item.file_id} />
                    <button
                      type="submit"
                      class="btn-danger"
                      aria-label={`Remove ${item.display_title} from this crate`}
                    ><Icon name="close" size={16} /></button>
                  </form>
                </td>
              )}
            </TrackRow>
          ))}
        </tbody>
      </table>
      </div>
    )}
  </article>
</Shell>
