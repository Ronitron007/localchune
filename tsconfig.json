{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // "node" is here for astro.config.ts alone (execSync, process.env for the
    // build-SHA injection) — it never leaks into src/, which stays Worker-only
    // via @cloudflare/workers-types.
    "types": ["@cloudflare/workers-types", "node"],
    // AllowlistForm.tsx (Task 6) is the project's first .tsx file. Without
    // this, tsc/astro check cannot resolve JSX.IntrinsicElements for Solid
    // components ("no interface 'JSX.IntrinsicElements' exists").
    "jsxImportSource": "solid-js"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
