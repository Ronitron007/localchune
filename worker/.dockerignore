# The venv is arm64 — copying it into an amd64 image would be actively wrong,
# and it is ~4 GB besides.
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Synthetic audio fixtures: 63 MB each, regenerated by bench/make_fixtures.py
# on demand. Generate them inside the container when a timing check needs one.
bench/fixtures/
bench/results_*.json

# Exported ONNX graphs (~82 MB). Task 2 chose PyTorch; the .onnx file exists
# only for the amd64 re-check, which runs in a throwaway bench container with
# the file mounted, never in the shipped image.
models/*.onnx

Dockerfile
.dockerignore
