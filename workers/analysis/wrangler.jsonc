// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "localchune-analysis",
  // Paths are resolved relative to THIS file, not the repo root.
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // No "routes", and workers_dev explicitly off — same posture as the
  // maintenance Worker. Nothing here is reachable from the internet; it is
  // driven by the queue (Task 9). Omitting "routes" alone is not enough: an
  // account with workers.dev enabled would still publish
  // <name>.<subdomain>.workers.dev.
  "workers_dev": false,

  // Container cold starts, container errors and per-track cpu_seconds all
  // surface here. Without it, a failed analysis is invisible.
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "AnalysisContainer",
      "image": "../../worker/Dockerfile",
      "image_build_context": "../../worker",

      // Peak RSS is ~1 GB (1058 MB measured for Beat This! on the M1
      // baseline), which wants ~2 GiB. Custom instance types enforce a
      // MINIMUM of 3 GiB memory per vCPU, so 3 GiB is the cheapest legal
      // 1-vCPU box and the floor is what sets this number, not the workload.
      //
      // Do NOT "save money" by dropping to `basic` (1/4 vCPU, 1 GiB): memory
      // is billed on PROVISIONED resources for as long as the instance is
      // awake, so 1/4 vCPU stretches ~35 vCPU-s into ~140s wall = 140 GiB-s,
      // worse than 3 GiB x 35s = 105 GiB-s, and four times slower. Fractional
      // vCPUs are strictly dominated for this workload.
      //
      // Nor to the named `standard-2` (1 vCPU, 6 GiB, 12 GB): same vCPU,
      // DOUBLE the memory, and memory bills on wall clock — it is the same
      // machine for this workload at twice the memory cost.
      //
      // disk_mb 6000 because the custom-instance rule is a MAXIMUM of 2 GB
      // disk per 1 GiB memory: 3 GiB buys at most 6 GB and we take all of it.
      // The working set is one audio file plus its derived artifacts, so it
      // is never close to full; the headroom exists so a leaked working
      // directory shows up as slow drift rather than an immediate failure.
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 6000 },

      // max_instances ERRORS when exceeded, it does not queue. Kept above the
      // consumer's max_concurrency (4, Task 9) and above the DO pool size (4,
      // src/index.ts) so a burst never trips it, and low enough that a
      // runaway loop is bounded. NOT enforced in local dev — the "too many
      // concurrent containers" error is a production-only failure mode.
      "max_instances": 8
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "ANALYSIS", "class_name": "AnalysisContainer" }]
  },
  // Container-backed DOs must use new_sqlite_classes, not new_classes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AnalysisContainer"] }],

  // The whole reason a container on Cloudflare beats an external host: no S3
  // access key exists anywhere in this design. The DO reads and writes R2
  // through this binding and hands the container nothing but bytes.
  // No "remote": true here, unlike the app and maintenance Workers — this
  // Worker is never run under `wrangler dev` against production data.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "localchune-audio" }]
}
