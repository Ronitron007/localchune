// localchune — MIT licensed. See LICENSE.
// NOTE: the distributed combination is AGPL-3.0 because the analysis
// worker includes Essentia. LICENSE explains why.

{
  "name": "localchune-maintenance",
  // Paths are resolved relative to THIS file, not the repo root.
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // No "routes", and workers_dev explicitly off. This Worker holds a
  // service_role key; it must have no reachable URL of any kind. Omitting
  // "routes" alone is not enough -- an account with workers.dev enabled
  // would still publish <name>.<subdomain>.workers.dev, and there would be
  // no fetch handler to answer it but the endpoint would exist.
  "workers_dev": false,

  // Nobody watches a 04:40 cron. Without this, a failing sweep is invisible.
  "observability": { "enabled": true },

  // UTC, always -- Cloudflare crons have no timezone.
  //   "17 * * * *" hourly at :17. The sweeper. Offset from the top of the
  //     hour to dodge the platform's busiest scheduling minute. Hourly
  //     rather than daily because an abandoned multipart upload BILLS for
  //     its stored parts from the moment it stalls: R2's own auto-abort is
  //     7 days, the lifecycle rule from Task 1 cuts that to 1 day as a
  //     backstop, and this is the primary mechanism that ends it within an
  //     hour of the 24h threshold.
  //   "31 * * * *" hourly at :31. M3's stuck-job cron. Re-enqueues files
  //     that have sat in received or analysing for over an hour -- a send
  //     that failed, a message that died in the DLQ, or a row that predates
  //     the producer. Offset from :17 so the two hourly jobs never contend.
  //   "40 4 * * *" nightly. The R2 reconcile. Listing the whole bucket is
  //     the expensive one, so it runs once, off-peak.
  //   "47 * * * *" hourly at :47. M4's dedup backstop. The analysis
  //     consumer runs the matcher inline after analysis_persist(),
  //     best-effort: it CANNOT retry, because a redelivery finds the file
  //     already 'stored' and acks as "not claimable". This job re-runs the
  //     matcher over anything that came out of analysis with a fingerprint
  //     and no track_id, then seeds identities for whatever could not be
  //     matched at all. Offset from :17 and :31 so the three hourly jobs
  //     never contend.
  // These four strings are duplicated as constants in src/index.ts and must
  // stay identical -- the scheduled handler dispatches on controller.cron.
  "triggers": { "crons": ["17 * * * *", "31 * * * *", "40 4 * * *", "47 * * * *"] },

  // The reconcile is I/O-bound (thousands of awaits, almost no compute), so
  // this ceiling is about a runaway loop, not about normal operation.
  "limits": { "cpu_ms": 30000 },

  // R2_BUCKET must name the SAME bucket as the binding below. The binding
  // does the listing and the deletes; R2_BUCKET only builds the SigV4 URL
  // for AbortMultipartUpload, which the binding does not expose. It also
  // doubles as sweep()'s production guard (src/index.ts) -- see env.dev
  // below for why that matters.
  // RECONCILE_DELETE_ORPHANS / RECONCILE_DELETE_PENDING are strings, not
  // booleans: wrangler vars are strings, and "false" is truthy in JS --
  // src/index.ts compares both to the literal "true" for that reason.
  "vars": {
    "R2_BUCKET": "localchune-audio",
    "RECONCILE_DELETE_ORPHANS": "false",
    "RECONCILE_DELETE_PENDING": "false"
  },

  // "remote": true for the same reason Task 1 gives on the app Worker: in
  // local dev, miniflare's R2 is a separate, empty bucket, and a reconcile
  // run against it reports every single file as missing. That is not a
  // useful failure, it is a misleading one.
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "localchune-audio", "remote": true }
  ],

  // PRODUCER ONLY -- this Worker enqueues, workers/analysis/ consumes.
  //
  // "remote": true so a manual run reaches the real queue:
  //   npx wrangler dev -c workers/maintenance/wrangler.jsonc --test-scheduled
  //   curl "http://localhost:8787/__scheduled?cron=31+*+*+*+*"
  // Unlike the sweeper, that is a benign thing to point at production:
  // analysis_stuck() changes no state, and a duplicate message is acked by
  // the consumer as "not claimable" or absorbed by analysis_persist()'s
  // upsert. env.dev below deliberately drops the flag, so a --env dev run
  // sends into miniflare's local queue and reaches nothing.
  "queues": {
    "producers": [
      { "binding": "ANALYZE_QUEUE", "queue": "localchune-analyze", "remote": true }
    ]
  },

  // Important #1 (M2 final review): without this block, `wrangler dev`
  // against this config defaulted straight to the PRODUCTION bucket and
  // (via .dev.vars) whatever Supabase project SUPABASE_URL pointed at --
  // there was no way to run a manual SWEEP_OLDER_THAN verification without
  // aiming at production. `vars` and `r2_buckets` are both non-inheritable
  // Wrangler config keys (see the config reference), so overriding either
  // one for an environment means BOTH must be fully redeclared here, not
  // just the values that differ from the top level.
  //
  // Run a manual sweep test with:
  //   npx wrangler dev -c workers/maintenance/wrangler.jsonc --env dev --test-scheduled
  // src/index.ts's sweep() additionally refuses to run at all when
  // SWEEP_OLDER_THAN is set and R2_BUCKET is still "localchune-audio", so a
  // forgotten --env dev fails loudly instead of touching production.
  "env": {
    "dev": {
      "vars": {
        "R2_BUCKET": "localchune-audio-dev",
        "RECONCILE_DELETE_ORPHANS": "false",
        "RECONCILE_DELETE_PENDING": "false"
      },
      "r2_buckets": [
        { "binding": "AUDIO", "bucket_name": "localchune-audio-dev", "remote": true }
      ],
      // No "remote" here, on purpose: a --env dev run must not be able to
      // push work at the production consumer, which would wake real
      // containers against real audio.
      "queues": {
        "producers": [
          { "binding": "ANALYZE_QUEUE", "queue": "localchune-analyze" }
        ]
      }
    }
  }
}
