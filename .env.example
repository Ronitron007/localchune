# .env — read by the app and by `astro build` (astro build copies every var
# in this file verbatim into dist/server/.dev.vars). Public-by-design values
# only.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# The public art bucket's domain (spec 2026-08-01-art-bucket-split). UNSET is
# not a failure and that is the danger: every art URL silently falls back to
# the signed per-track route, which costs a Worker invocation and an
# uncacheable redirect for each of the ~100 thumbs on a pool page. Prod uses
# the custom domain; dev uses the managed r2.dev URL of localchune-art-dev.
# Any new PUBLIC_* var must ALSO be added to .github/workflows/deploy.yml, or
# CI deploys bake it as undefined.
PUBLIC_ART_BASE_URL=https://art.butternutcrack.com

# .secrets.env — a SEPARATE gitignored file, CLI use only (e.g.
# `supabase db push`). Never read by the app or the build. Source by hand:
#   set -a; source .secrets.env; set +a
#
# SUPABASE_SERVICE_KEY=
# SUPABASE_DB_PASSWORD=
