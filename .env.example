# .env — read by the app and by `astro build` (astro build copies every var
# in this file verbatim into dist/server/.dev.vars). Public-by-design values
# only.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# .secrets.env — a SEPARATE gitignored file, CLI use only (e.g.
# `supabase db push`). Never read by the app or the build. Source by hand:
#   set -a; source .secrets.env; set +a
#
# SUPABASE_SERVICE_KEY=
# SUPABASE_DB_PASSWORD=
